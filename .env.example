APP_NAME=MediGuide
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=fr

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3307
DB_DATABASE=mediguide
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
QUEUE_CONNECTION=database
CACHE_STORE=database

# ---------------------------------------------------------------------------
# E-mail — trois modes possibles
# ---------------------------------------------------------------------------
# 1) log   : AUCUN envoi. Le message est écrit dans storage/logs/laravel.log.
#            Pratique en développement, mais rien n'arrive dans une boîte.
# 2) smtp vers Mailpit (Docker) : envoi SMTP RÉEL, consultable sur
#            http://localhost:8025 — idéal pour démontrer en soutenance.
#              MAIL_MAILER=smtp
#              MAIL_HOST=127.0.0.1      (ou "mailpit" depuis un conteneur)
#              MAIL_PORT=1025
# 3) smtp vers un fournisseur : livraison dans une VRAIE boîte.
#    3a) Gmail — configuration retenue pour la démonstration. Il faut d'abord
#        activer la validation en deux étapes sur le compte Google, puis créer
#        un « mot de passe d'application » (https://myaccount.google.com/apppasswords) :
#        Gmail refuse le mot de passe habituel du compte depuis 2022.
#              MAIL_MAILER=smtp
#              MAIL_HOST=smtp.gmail.com
#              MAIL_PORT=587
#              MAIL_USERNAME=<adresse Gmail complète>
#              MAIL_PASSWORD=<les 16 caractères, SANS les espaces>
#        Limite : environ 500 envois par jour, suffisant pour une soutenance.
#    3b) Brevo — si un volume plus élevé est nécessaire (300/jour en gratuit,
#        mais domaine expéditeur dédié et meilleure délivrabilité) :
#              MAIL_HOST=smtp-relay.brevo.com
#              MAIL_USERNAME=<identifiant fourni par Brevo>
#              MAIL_PASSWORD=<clé SMTP fournie par Brevo>
# Le mot de passe d'application ne doit JAMAIS être versionné : il reste dans
# le .env local, que .gitignore exclut déjà.
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=notifications@mediguide.sn
MAIL_FROM_NAME="MediGuide"

# SMS Twilio (mode trial) — optionnel.
# Laissé vide : les SMS sont journalisés ([SMS simulé]) et l'e-mail reste le canal
# opérationnel. Renseigné : envoi réel, un échec est journalisé puis réessayé par la file.
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=

# Services OpenStreetMap — vides : serveurs publics (par défaut).
# Renseignés : instances auto-hébergées (cf. README, profil Docker "osm"),
# ce qui supprime la dépendance externe documentée en section 8 du mémoire.
#   OSRM_URL=http://osrm:5000
#   NOMINATIM_URL=http://nominatim:8080
OSRM_URL=
NOMINATIM_URL=

# NE PAS activer PHP_CLI_SERVER_WORKERS sous Windows : le mode multi-worker du
# serveur intégré de PHP n'y est pas supporté et fait geler les requêtes
# de "php artisan serve" (erreurs "Maximum execution time exceeded").

# ---------------------------------------------------------------------------
# Comptes de démonstration (créés par le seeder)
# ---------------------------------------------------------------------------
# Par défaut : adresses fictives @demo.sn — aucun e-mail ne peut donc partir.
# Pour recevoir réellement les notifications, mettre de vraies adresses. Avec
# Gmail, tout ce qui suit le « + » est ignoré : les trois arrivent dans la même
# boîte tout en restant distinguables (utile pour filtrer et trier).
#   DEMO_PATIENT_EMAIL=monadresse+patient@gmail.com
#   DEMO_MEDECIN_EMAIL=monadresse+medecin@gmail.com
#   DEMO_ADMIN_EMAIL=monadresse+admin@gmail.com
DEMO_PATIENT_EMAIL=
DEMO_MEDECIN_EMAIL=
DEMO_ADMIN_EMAIL=
